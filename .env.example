# ── Server ───────────────────────────────────────────────────────────────────
# API_PORT, not PORT: a dev-server harness that proxies a browser preview may set
# PORT itself (to whatever it's proxying to), and since this API is often started
# alongside the Vite dev server under one shared environment (npm run dev), a bare
# PORT here would collide with Vite's own port instead of naming the API's.
API_PORT=8787
# Where the SQLite database lives. On Railway point this at a mounted volume,
# e.g. /data — the container filesystem is wiped on every redeploy.
DATA_DIR=./data
# Used to decide whether the session cookie gets its Secure flag. Set this to
# the real https:// URL in production; leaving it as http://localhost in dev is
# what keeps login working there.
PUBLIC_BASE_URL=http://localhost:8787
# Directory of built web assets to serve. Defaults to apps/web/dist.
# WEB_ROOT=

# The one account that is force-promoted to admin on every boot, so there is
# always a way in. It only ever grants — demoting it later (once a second admin
# exists) sticks.
FOUNDING_ADMIN_USERNAME=ruandj
# Only used to CREATE that account on a database where it doesn't exist yet
# (e.g. a fresh Railway deploy) -- ignored once the account is there, so it never
# overwrites a password set at signup. Defaults to Rdj@5046 if unset; override here
# per-environment, e.g. in Railway's own variables, rather than relying on that default.
FOUNDING_ADMIN_PASSWORD=

# ── Farmranger logs API ──────────────────────────────────────────────────────
# Needs no key. Called as <base><imei>/logs?From=…&To=…
LOGS_API_BASE=https://api.services.farmrangersa.com/v2/unit/

# ── Farmranger settings API ──────────────────────────────────────────────────
# This one needs a bearer token. Called as <base><imei>/settings, and read for
# dailyReportStartTime / dailyReportInterval / dailyReportCountPerDay — the
# daily report series each device's polling follows.
#
# Leave the token blank and every device simply keeps the schedule stored
# against it (by default: 19 hourly reports from 04:10, logs read 10 minutes
# after each, so 04:20 through 22:20).
SETTINGS_API_BASE=https://api.farmrangersa.com/api/v2018-02-04/units/
# Never commit this. It is a long-lived JWT — treat it like a password.
SETTINGS_API_TOKEN=

# ── Ingest ───────────────────────────────────────────────────────────────────
# How far back a brand-new device is backfilled on its first read, in days.
BACKFILL_DAYS=7
# How far before its last known reading each poll re-reads. Devices upload a
# bracket late often enough that this overlap matters; re-reads are no-ops.
POLL_LOOKBACK_HOURS=4
# Discovery timestamps round to the nearest bracket of this many minutes, which
# is what turns several devices' blocks into one round.
BRACKET_MINUTES=15
