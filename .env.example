# ── Server ───────────────────────────────────────────────────────────────────
# API_PORT, not PORT: a dev-server harness that proxies a browser preview may set
# PORT itself (to whatever it's proxying to), and since this API is often started
# alongside the Vite dev server under one shared environment (npm run dev), a bare
# PORT here would collide with Vite's own port instead of naming the API's.
API_PORT=8787
# Where the SQLite database lives. On Railway point this at a mounted volume,
# e.g. /data — the container filesystem is wiped on every redeploy.
# Use an absolute path, not a relative one: a relative path resolves against
# whatever the current working directory happens to be, and that differs
# between `npm start` (repo root) and `npm run dev --workspace @tagexplore/api`
# (that workspace's own directory — npm's own behaviour for a
# --workspace-scoped script), which can quietly split one database into two.
DATA_DIR=/absolute/path/to/data
# Used to decide whether the session cookie gets its Secure flag. Set this to
# the real https:// URL in production; leaving it as http://localhost in dev is
# what keeps login working there.
PUBLIC_BASE_URL=http://localhost:8787
# Directory of built web assets to serve. Defaults to apps/web/dist.
# WEB_ROOT=

# The one account that is force-promoted to admin on every boot, so there is
# always a way in. It only ever grants — demoting it later (once a second admin
# exists) sticks.
FOUNDING_ADMIN_USERNAME=ruandj
# Only used to CREATE that account on a database where it doesn't exist yet
# (e.g. a fresh Railway deploy) -- ignored once the account is there, so it never
# overwrites a password set at signup. Defaults to Rdj@5046 if unset; override here
# per-environment, e.g. in Railway's own variables, rather than relying on that default.
FOUNDING_ADMIN_PASSWORD=

# ── Farmranger logs API ──────────────────────────────────────────────────────
# Needs no key. Called as <base><imei>/logs?From=…&To=…
LOGS_API_BASE=https://api.services.farmrangersa.com/v2/unit/

# ── Farmranger settings API ──────────────────────────────────────────────────
# This one needs a bearer token. Called as <base><imei>/settings, and read for
# dailyReportStartTime / dailyReportInterval / dailyReportCountPerDay — the
# daily report series each device's polling follows.
#
# Leave the token blank and every device simply keeps the schedule stored
# against it (by default: 19 hourly reports from 04:10, logs read 10 minutes
# after each, so 04:20 through 22:20).
SETTINGS_API_BASE=https://api.farmrangersa.com/api/v2018-02-04/units/
# Never commit this. It is a long-lived JWT — treat it like a password.
SETTINGS_API_TOKEN=

# ── Telegram bot provisioning (optional) ─────────────────────────────────────
# Shared secret the Telegram tag bot's manager uses to list organisations and
# mint/level/revoke per-bot access tokens (server-to-server, no login). Set the
# same value on the bot's WEB_PROVISION_TOKEN. Blank disables the provisioning
# API entirely (the per-bot read API at /api/bot/* is unaffected). Treat like a
# password.
BOT_PROVISION_TOKEN=

# ── Ingest ───────────────────────────────────────────────────────────────────
# How far back a brand-new device is backfilled on its first read, in days.
BACKFILL_DAYS=7
# How far before its last known reading each poll re-reads. Devices upload a
# bracket late often enough that this overlap matters; re-reads are no-ops.
POLL_LOOKBACK_HOURS=4
# Discovery timestamps round to the nearest bracket of this many minutes, which
# is what turns several devices' blocks into one round.
BRACKET_MINUTES=15

# ── Reader position ──────────────────────────────────────────────────────────
# A reader never reports its own position in the discovery data — not in a
# scraped log block, not in a pushed CBOR campaign — so it is read separately
# off the events API (same host and token as the settings API above), on its
# own cadence rather than as a side effect of a log scrape.
POSITION_POLL_MINUTES=5
# A campaign landing also asks for that reader's position straight away, since
# the events API only ever serves the single newest event. This debounces that,
# so a unit posting a burst makes one call.
POSITION_POLL_ON_PUSH_MINUTES=5

# How close a fix has to be to a discovery before it counts as that discovery's
# position. Outside this, the reader is shown greyed rather than presented as
# current, and its carried tag's position for that round is used instead if
# there is one.
DEVICE_POSITION_WINDOW_MINUTES=10
# A scraped round only knows the 15-minute bracket its blocks fell in, so its
# true time is within ±BRACKET_MINUTES/2 of that. On (the default), the window
# is widened by that much for a scraped round; a pushed one knows exactly when
# it arrived and never gets the slack. Set to 0 to judge both strictly.
DEVICE_POSITION_BRACKET_SLACK=1

# ── Push ingest ──────────────────────────────────────────────────────────────
# How long a reader on ingest_mode='auto' may go without pushing before it
# falls back to log scraping. Three missed hourly campaigns by default, so
# ordinary jitter never flaps it. A reader pinned to 'push' never falls back.
PUSH_GRACE_MINUTES=180

# ── Live updates ─────────────────────────────────────────────────────────────
# The SSE stream at /api/events is what replaced the app's Refresh button.
# Heartbeat keeps an idle-timeout proxy from closing the connection, and gives
# the browser something to measure silence against.
LIVE_HEARTBEAT_SECONDS=25
# Runaway-tab guard: past this, /api/events answers 503 for that organisation
# and the client falls back to polling.
LIVE_MAX_SUBSCRIBERS_PER_ORG=50

# ── Learned device identities ────────────────────────────────────────────────
# A reader's radio id (what tags name in their RssiSrc column) and the ordinary
# tag carried by the same animal are both worked out from the readings. An
# admin can type either by hand, and a hand-typed value is never written over.
INFERENCE_WINDOW_DAYS=7
INFERENCE_INTERVAL_MINUTES=30
# A pushed campaign reports the radio id outright, so this only gates the
# wave-one vote a scraped reader's id has to be inferred from.
RADIO_ID_MIN_ROUNDS=5
RADIO_ID_MIN_SHARE=0.8
# About a day of evidence at 19 reports a day. The margin is what makes a
# near-tie abstain instead of guessing between two plausible answers.
CARRIED_TAG_MIN_ROUNDS=20
CARRIED_TAG_MIN_SCORE=0.8
CARRIED_TAG_MIN_MARGIN=0.15
