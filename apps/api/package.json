{
  "name": "@tagexplore/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hono API: Farmranger log ingest, tag/battery queries, org-device-tag administration.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --no-warnings=ExperimentalWarning --import tsx/esm --watch src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --noEmit",
    "vapid-keys": "node -e \"const c=require('node:crypto').createECDH('prime256v1');c.generateKeys();console.log('VAPID_PUBLIC_KEY='+c.getPublicKey().toString('base64url'));console.log('VAPID_PRIVATE_KEY='+c.getPrivateKey().toString('base64url'))\""
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@tagexplore/core": "*",
    "cbor2": "^2.3.0",
    "hono": "^4.6.14",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
