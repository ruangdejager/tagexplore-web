{
  "name": "@tagexplore/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hono API: Farmranger log ingest, tag/battery queries, org-device-tag administration.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --no-warnings=ExperimentalWarning src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@tagexplore/core": "*",
    "hono": "^4.6.14",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
